# TYPER Magic — macOS · copie para .env (gitignored) e preencha. NUNCA commite o .env.
# Carregado por scripts/env.sh antes do node (o repo não lê .env sozinho). Valor com espaço: entre aspas.

# --- obrigatórios ---------------------------------------------------------
# Token do bot (@BotFather)
TYPER_TELEGRAM_TOKEN=
# Seu id numérico do Telegram (allowlist: só este id é atendido). Vários: separe por vírgula.
TYPER_TELEGRAM_ALLOW=
# Chave da API Anthropic (BYOK). Alternativa: `typermagic login anthropic` (OAuth em ~/.typer/auth.json)
TYPER_ANTHROPIC_KEY=

# --- modelo ----------------------------------------------------------------
# provider preferido: anthropic | openai | ollama | llamacpp (default: anthropic se houver chave)
TYPER_PROVIDER=anthropic
# override de modelo (vazio = default do provider)
TYPER_MODEL=
# TYPER_OPENAI_KEY=            # opcional (openai-responses já tem visão)
# EXA_API_KEY=                 # opcional: busca web via Exa (reach_search)

# --- navegador (Fase 3) ----------------------------------------------------
# Binário do navegador real. Default: Brave, depois Chrome.
TYPER_BROWSER_PATH="/Applications/Brave Browser.app/Contents/MacOS/Brave Browser"
# Perfil DEDICADO do navegador (nunca o seu perfil pessoal). Porta de depuração CDP.
TYPER_BROWSER_PROFILE=~/.typer/browser/cdp-profile
TYPER_CDP_PORT=9222

# --- desktop / macOS (Fase 2) ----------------------------------------------
# Resolução LÓGICA declarada ao modelo (o screenshot Retina 2x é reduzido para isto).
TYPER_SCREEN_LOGICAL_WIDTH=1440
# Display: main (padrão) ou o índice do display (0,1,…)
TYPER_DISPLAY=main
# Apps que o agente pode controlar (allowlist por nome, separada por vírgula). Vazio = nenhum.
TYPER_ALLOWED_APPS="TextEdit,Brave Browser,Finder,Notes,Calendar,Mail"

# --- segurança (Fase 5) ----------------------------------------------------
# Hosts onde checkout/pagamento é permitido (vazio = pagamento bloqueado em todo lugar)
TYPER_CHECKOUT_ALLOW_HOSTS=
# Teto por transação e por dia (BRL, inteiro). 0 = bloqueia qualquer pagamento.
TYPER_MAX_PER_TX=0
TYPER_MAX_PER_DAY=0
# Arquivo-flag do kill switch: existir = aborta o loop imediatamente
TYPER_STOP_FILE=~/.typer/STOP
# Log estruturado JSONL de cada passo (rotaciona por tamanho)
TYPER_STEP_LOG=~/Library/Logs/typermagic/steps.jsonl
TYPER_STEP_LOG_MAX_MB=20

# --- serviço (Fase 6) -------------------------------------------------------
TYPER_LOG_DIR=~/Library/Logs/typermagic

# --- Aprendizado por tutorial (Fase 7: /aprender) ---
# Pasta de trabalho (vídeo, legendas, frames, descrições). Padrão ~/.typer/learn
TYPER_LEARN_DIR=
# Modelo de visão p/ descrever frames (muitos frames; use um modelo médio). Padrão: claude-sonnet-5-5
TYPER_LEARN_VISION_MODEL=
# Modelo p/ destilar o procedimento (qualidade da skill). Padrão: TYPER_MODEL
TYPER_LEARN_MODEL=

# --- Central de Reuniões (docs/CENTRAL-REUNIOES.md) ---------------------------
# Pasta única onde cada reunião vira um .md + o índice REUNIOES.md. Padrão ~/Reunioes
TYPER_MEETINGS_DIR=
# Modelo p/ resumir/traduzir (padrão: o modelo principal, TYPER_MODEL/gateway.json)
TYPER_MEETINGS_MODEL=
# Intervalo do vigia (segundos; padrão 120)
TYPER_MEETINGS_POLL_SEC=
# Discord: token do bot SÓ-LEITURA (Developer Portal → Bot → Reset Token). Vazio = fonte desligada
TYPER_DISCORD_TOKEN=
# Nome do canal de texto com as transcrições (padrão "transcrições"); ou o id direto
TYPER_DISCORD_CHANNEL=
TYPER_DISCORD_CHANNEL_ID=
# Google Drive: JSON do OAuth client "App para computador" (padrão ~/.typer/google-client.json).
# O token de acesso fica em ~/.typer/google-token.json depois de `typermagic reunioes google-auth`.
TYPER_GOOGLE_CLIENT_FILE=
# Termos no NOME dos docs de anotações do Gemini (separe por vírgula). Padrão "Gemini"
TYPER_MEET_NAME_MATCH=
